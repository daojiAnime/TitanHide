#include <windows.h>
#include "resource.h"

// Keep dialog simple: MS Shell Dlg, no out-of-bounds controls (x64dbg-safe)
IDD_PANEL DIALOGEX 0, 0, 300, 280
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "TiDaoji Control Panel"
FONT 8, "MS Shell Dlg"
BEGIN
    LTEXT           "Status: (click Refresh)", IDC_LBL_STATUS, 8, 8, 284, 20
    LTEXT           "PID: -", IDC_LBL_PID, 8, 30, 220, 10
    RTEXT           "Driver:", -1, 8, 46, 30, 10
    EDITTEXT        IDC_EDT_DRIVER, 42, 44, 90, 12, ES_AUTOHSCROLL
    PUSHBUTTON      "Refresh", IDC_BTN_REFRESH, 140, 43, 48, 14
    LTEXT           "OPEN FAIL => admin: kdu -dse 0, sc start TiDaoji, kdu -dse 6", IDC_LBL_HINT, 8, 60, 284, 10

    GROUPBOX        "Hide Type", -1, 8, 74, 200, 170
    AUTOCHECKBOX    "ProcessDebugFlags", IDC_CHK_PROCESSDEBUGFLAGS, 16, 88, 180, 10
    AUTOCHECKBOX    "ProcessDebugPort", IDC_CHK_PROCESSDEBUGPORT, 16, 100, 180, 10
    AUTOCHECKBOX    "ProcessDebugObjectHandle", IDC_CHK_PROCESSDEBUGOBJECTHANDLE, 16, 112, 180, 10
    AUTOCHECKBOX    "DebugObject", IDC_CHK_DEBUGOBJECT, 16, 124, 180, 10
    AUTOCHECKBOX    "SystemDebuggerInformation", IDC_CHK_SYSTEMDEBUGGERINFO, 16, 136, 180, 10
    AUTOCHECKBOX    "NtClose", IDC_CHK_NTCLOSE, 16, 148, 180, 10
    AUTOCHECKBOX    "ThreadHideFromDebugger", IDC_CHK_THREADHIDEFROMDBG, 16, 160, 180, 10
    AUTOCHECKBOX    "NtGetContextThread", IDC_CHK_NTGETCONTEXTTHREAD, 16, 172, 180, 10
    AUTOCHECKBOX    "NtSetContextThread", IDC_CHK_NTSETCONTEXTTHREAD, 16, 184, 180, 10
    AUTOCHECKBOX    "NtSystemDebugControl", IDC_CHK_NTSYSTEMDEBUGCONTROL, 16, 196, 180, 10
    AUTOCHECKBOX    "SystemFirmwareVMScrub", IDC_CHK_NTSYSTEMVMINFO, 16, 208, 180, 10
    AUTOCHECKBOX    "NtTerminateProcess", IDC_CHK_NTTERMINATEPROCESS, 16, 220, 180, 10

    PUSHBUTTON      "All", IDC_BTN_SELALL, 16, 234, 40, 14
    PUSHBUTTON      "None", IDC_BTN_SELNONE, 60, 234, 40, 14
    PUSHBUTTON      "Apply Type", IDC_BTN_APPLY, 108, 234, 56, 14

    GROUPBOX        "Actions", -1, 216, 74, 76, 170
    PUSHBUTTON      "Hide", IDC_BTN_HIDE, 224, 92, 60, 16
    PUSHBUTTON      "Unhide", IDC_BTN_UNHIDE, 224, 114, 60, 16
    PUSHBUTTON      "Unhide All", IDC_BTN_UNHIDEALL, 224, 136, 60, 16
    PUSHBUTTON      "SoftUnload", IDC_BTN_SOFTUNLOAD, 224, 158, 60, 16
    DEFPUSHBUTTON   "Close", IDC_BTN_CLOSE, 224, 210, 60, 16

    LTEXT           "NOT PG-safe. SYSTEMBP auto-hides if driver is up.", -1, 8, 262, 284, 10
END
